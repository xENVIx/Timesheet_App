<?xml version="1.0" encoding="utf-8"?>
<!--
  The setup wizard's progress screen showed each step's details template as-is, e.g.
  "Copying new files File: [1], Directory: [9], Size: [6]": WixUI's progress dialog has no place
  that fills those [n] values in. Blanking the templates leaves just the step, e.g. "Copying new files".
  Overrides the strings of the same name in WixToolset.UI.wixext (picked up automatically, like any .wxl).
-->
