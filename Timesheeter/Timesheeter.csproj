<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Icon of the .exe in Explorer and the taskbar. -->
    <ApplicationIcon>Resources\Timesheeter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded too, so the main window can use every size (the title bar wants 16/20/24px). -->
    <EmbeddedResource Include="Resources\Timesheeter.ico" LogicalName="Timesheeter.ico" />
    <EmbeddedResource Include="Timesheet_Template_Excel\Timesheet.xlsx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibSqlLite\LibSqlLite.csproj" />
  </ItemGroup>

</Project>